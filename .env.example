# Sent API key from https://app.sent.dm -> Developers -> API keys
SENT_DM_API_KEY=

# Signing secret for your webhook endpoint. Starts with whsec_
SENT_DM_WEBHOOK_SECRET=

# The phone number this demo notifies, in E.164 format
DEMO_PHONE_NUMBER=+15551234567

# Reference the template by id, or by name. The id wins if both are set.
SENT_TEMPLATE_ID=
SENT_TEMPLATE_NAME=

# Local webhook receiver
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhooks/sent

# Public HTTPS base URL of your tunnel, used only by npm run register-webhook
PUBLIC_WEBHOOK_URL=

# Set to true to have Sent simulate the send instead of delivering it
SENT_SANDBOX=false
